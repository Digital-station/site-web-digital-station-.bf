# ============================================================================
#  DIGITAL STATION — environment variables
# ============================================================================
#  Copy to `.env.local` and fill in. Next.js loads `.env.local` automatically
#  (unlike the old Vite setup, where `.env` was never read at all because
#  dotenv was a dependency that nothing imported).
#
#  NEXT_PUBLIC_* values are inlined into the browser bundle — never put a
#  secret in one.
# ============================================================================


# ── Contact form ────────────────────────────────────────────────────────────
# REQUIRED for the contact form to send anything. Without RESEND_API_KEY the
# /api/leads endpoint returns 503 and the form shows an error — deliberately,
# so a broken form is never mistaken for a working one.

RESEND_API_KEY=

# WHERE LEADS ARE DELIVERED — the inbox a submitted contact form arrives in.
# Any address you can read; it does NOT have to be on the verified domain.
# Unset, it falls back to `leadInbox` in config/site.config.ts.
CONTACT_EMAIL=infos@digitalstation.bf

# THE "FROM" ADDRESS — MUST be on a domain verified in the Resend dashboard.
# This is the single most common reason a form "works" but no mail arrives.
#
# Unset, the code falls back to Resend's sandbox sender, onboarding@resend.dev.
# That sender can ONLY deliver to the email address the Resend account itself
# was registered with. Every other recipient — including infos@digitalstation.bf
# — is rejected by Resend, so /api/leads returns 502 and the lead is lost.
#
# To make it work: add digitalstation.bf in Resend → Domains, publish the DKIM
# and SPF records it gives you, wait for "Verified", then set the line below.
# Format is "Display Name <address@verified-domain>".
LEADS_FROM="Digital Station <contact@digitalstation.bf>"


# ── Analytics (optional — nothing loads unless PROVIDER is set) ─────────────
# Leave blank and the site makes no third-party requests at all.
#
#   ga4  — the only supported provider. See the warning below.
#
# ⚠️  GA4 loads with Google Consent Mode defaulting to DENIED, because that is
#     the only lawful default in the EU. The consent banner (CookieConsent.tsx)
#     is what grants it, and only once a visitor explicitly accepts.

NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SITE_ID=


# ── Rate limit store for /api/leads (optional) ──────────────────────────────
# Unset, the lead endpoint rate-limits in memory — correct on a single
# long-lived process (cPanel/Docker/PM2), WRONG on Vercel's serverless
# functions, where every instance would keep its own count.
#
# Set BOTH to move the counters to Upstash Redis instead, shared across every
# instance. Vercel's Upstash marketplace integration sets these automatically
# when you add the integration to this project — you should not need to
# create an Upstash account or copy these by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Google Search Console (optional) ────────────────────────────────────────
# Only for the "HTML tag" verification method. Paste the TOKEN alone — the
# content="…" value from the tag Google shows, not the whole <meta> tag.
#
# ⚠️  Read at BUILD time. The pages are pre-rendered, so this must be set in
#     the shell (or .env.production) where `npm run build` runs. Setting it
#     only in cPanel's Node.js App screen does nothing until the next build.
#
# The DNS TXT record method needs none of this and covers every subdomain and
# both http/https — prefer it if you can edit the domain's DNS. See README.
GOOGLE_SITE_VERIFICATION=


# ── Runtime ─────────────────────────────────────────────────────────────────
# PORT=3000
