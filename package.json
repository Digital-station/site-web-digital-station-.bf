{
  "name": "digitalstation-web",
  "version": "1.0.0",
  "description": "Enterprise web platform and engineering showcase for Digital Station SARL (Ouagadougou, Burkina Faso).",
  "private": true,
  "author": "Digital Station SARL <infos@digitalstation.bf>",
  "homepage": "https://digitalstation.bf",
  "repository": {
    "type": "git",
    "url": "https://github.com/Digital-station/site-web-digital-station-.bf.git"
  },
  "bugs": {
    "url": "https://github.com/Digital-station/site-web-digital-station-.bf/issues"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "docker:build": "docker compose build --pull web",
    "docker:up": "docker compose up -d web",
    "docker:down": "docker compose down",
    "deploy": "./deploy/deploy.sh docker",
    "deploy:pm2": "./deploy/deploy.sh pm2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next": "16.3.3",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "resend": "^6.24.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "svgo": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ]
}
